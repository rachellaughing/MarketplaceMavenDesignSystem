{
  "$description": "Marketplace Maven brand color tokens — the actual live palette from mm-styles.css (source/mm-styles.css), the canonical consolidated stylesheet for the Divi child theme. Supersedes the Matrix-explorer-only palette this repo started with.",
  "surfaces": {
    "paper": "#FFFEFA",
    "sand": "#F6F2EA",
    "sandDeep": "#ECE6D9",
    "tealSoft": "#EDF2F0"
  },
  "ink": {
    "ink": "#1A2828",
    "inkSoft": "#6B6560"
  },
  "teal": {
    "teal": "#137474",
    "tealMid": "#2C7A6E",
    "tealBright": "#22BDC1",
    "tealPale": "#EDF7F7"
  },
  "ember": {
    "$description": "Primary CTA / action color.",
    "ember": "#F05223",
    "emberHover": "#D6431A",
    "emberPale": "#FDF0EA"
  },
  "notePale": "#FFFCEF",
  "darkSections": {
    "depth": "#1F3536",
    "abyss": "#182829",
    "night": "#0D1A1C",
    "legacyAliases": { "forest": "depth (legacy name, prefer --mm-depth)", "dark": "abyss (legacy name, prefer --mm-abyss)" }
  },
  "accentSet": {
    "$description": "Traffic-key / data-viz accent colors, distinct from the Revenue Health Matrix's own 5 system colors in matrix-system-colors.json.",
    "green": "#7DC855",
    "amber": "#F5A623",
    "red": "#F05223 (= ember)",
    "purple": "#B06FD8"
  },
  "rulesAndShadows": {
    "rule": "rgba(26, 40, 40, 0.14)",
    "ruleLight": "rgba(255, 254, 250, 0.12)",
    "shadowPaper": "0 1px 0 rgba(26, 40, 40, 0.04), 0 2px 6px rgba(26, 40, 40, 0.04)"
  }
}
